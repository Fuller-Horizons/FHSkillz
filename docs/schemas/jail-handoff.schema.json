{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fuller-Horizons/FHSkillz/docs/schemas/jail-handoff.schema.json",
  "title": "JAIL-HANDOFF block (FHSkillz 0.27.0)",
  "description": "The compact envelope every kernel skill ends with. Key order is canonical: skill, status, facts, assumptions, unknowns, outputs, evidence, risks, confidence, next, approval_required, checks.",
  "type": "object",
  "x-key-order": ["skill", "status", "facts", "assumptions", "unknowns", "outputs", "evidence", "risks", "confidence", "next", "approval_required", "checks"],
  "required": ["skill", "status", "unknowns", "approval_required"],
  "additionalProperties": false,
  "properties": {
    "skill": {"type": "string", "pattern": "^jail-[a-z0-9-]+$"},
    "status": {"enum": ["complete", "partial", "blocked", "stop"]},
    "facts": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "next": {"type": "string"},
    "approval_required": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "object",
      "additionalProperties": {"enum": ["pass", "fail", "error", "n/a"]}
    }
  }
}
